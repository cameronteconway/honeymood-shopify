{% liquid
  assign section_id = section.id
  assign background_color = section.settings.background_color
  assign text_color = section.settings.text_color
  assign logo = section.settings.logo
  assign logo_width = section.settings.logo_width
  assign icon_color = section.settings.icon_color
%}

{% liquid
  if section.settings.section_background_color != blank
    render 'contrast-override', background_color: section.settings.section_background_color, section_id: section.id
  endif
%}

<div
  class="section-background{% if section.settings.section_background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>

<div class="section section--page-width honeymood-footer">
  <div class="footer-container color-custom-{{ section.id }}">
    <div class="footer-content">
      {%- comment -%}__ Brand Column (Logo / Store Name + Hardcoded Social Icons) __{%- endcomment -%}
      <div class="footer-column footer-brand">
        <div class="footer-logo">
          {%- if logo != blank -%}
            <a href="{{ routes.root_url }}">
              <img
                src="{{ logo | image_url: width: 600 }}"
                alt="{{ shop.name | escape }}"
                loading="lazy"
                width="{{ logo_width }}"
                height="{{ logo_width | divided_by: logo.aspect_ratio | round }}"
                style="max-width: {{ logo_width }}px; height: auto;"
              >
            </a>
          {%- else -%}
            <a href="{{ routes.root_url }}" class="footer-store-name">
              {{ shop.name }}
            </a>
          {%- endif -%}
        </div>

        {%- comment -%}__ Built-in Social Icons Logic __{%- endcomment -%}
        {%- liquid
          assign social_links = 'facebook_url,instagram_url,youtube_url,tiktok_url,twitter_url,threads_url,linkedin_url,bluesky_url,snapchat_url,pinterest_url,tumblr_url,vimeo_url,custom_url' | split: ','
        -%}

        <div class="social-icons__wrapper social-icons__wrapper--{{ section.id }}">
          {%- for link_key in social_links -%}
            {%- liquid
              assign link_url = section.settings[link_key]
              assign platform = link_key | remove: '_url'

              if link_key == 'custom_url' and link_url != blank
                assign platform = link_url | split: '//' | last | remove: 'www.' | split: '.' | first
                if platform == 'x'
                  assign platform = 'twitter'
                endif
              endif
            -%}

            {%- if link_url != blank -%}
              <div class="social-icons__icon-wrapper">
                <a
                  href="{{ link_url }}"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="{{ platform | capitalize }}"
                >
                  <span class="social-icons__icon-label">{{ platform | capitalize }}</span>
                  <svg
                    class="social-icons__icon icon-default"
                    aria-hidden="true"
                    focusable="false"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 20 20"
                  >
                    {%- render 'icon', icon: platform -%}
                  </svg>
                </a>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

      {%- comment -%}__ Dynamic Block Columns (Menus, etc.) __{%- endcomment -%}
      <div class="footer-column footer-menus">
        {% content_for 'blocks' %}
      </div>
    </div>

    {%- comment -%}__ Footer Bottom / Policy Row __{%- endcomment -%}
    <div class="footer-policy">
      <div class="footer-copyright">
        {%- if section.settings.copyright_text != blank -%}
          {{ section.settings.copyright_text }}
        {%- else -%}
          &copy; {{ 'now' | date: '%Y' }}, {{ shop.name | link_to: routes.root_url }}. All rights reserved.
        {%- endif -%}
      </div>

      {%- comment -%}__ Hardcoded Store Policy Links __{%- endcomment -%}
      {%- if section.settings.show_policy_links and shop.policies.size > 0 -%}
        <ul class="footer-policy-list">
          {%- for policy in shop.policies -%}
            {%- if policy != blank -%}
              <li>
                <a href="{{ policy.url }}">{{ policy.title | escape }}</a>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</div>

{% style %}
  footer:has(.honeymood-footer) .honeymood-footer {
    padding: 24px 0 24px 0;
  }


  .honeymood-footer .footer-store-name {
    font-family: 'Cormorant Garamond', serif !important;
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: none;
  }

  .honeymood-footer .footer-container {
    border-radius: 12px;
  }

  .honeymood-footer .footer-container .footer-content {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 30px;
    padding: 24px 24px 48px 24px;

  }

  .honeymood-footer .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 15px;
  }

  .honeymood-footer .footer-store-name {
    font-size: 1.5rem;
    font-weight: bold;
    text-decoration: none;
    color: inherit;
  }

  /* Social Icons Styling */
  .social-icons__wrapper {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    align-items: center;
  }

  .social-icons__icon-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
  }

  .social-icons__icon-wrapper a {
    color: {% if icon_color != blank %}{{ icon_color }}{% else %}inherit{% endif %};
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .social-icons__icon {
    width: 20px;
    height: 20px;
    fill: currentColor;
  }

  .social-icons__icon-label {
    display: none;
  }

  .honeymood-footer .footer-menus {
    display: contents;
  }

  /* Menu Heading Styling */
  .honeymood-footer .menu__heading {
    padding-top: 0;
  }
  .honeymood-footer .menu__heading .menu__heading__default {
    font-family: 'Cormorant Garamond', serif !important;
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: none;
  }

  /* Policy Links & Copyright Row */
  .honeymood-footer .footer-policy {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
    padding: 24px;
    /* border-top: 1px solid rgba(255, 255, 255, 0.1); */
  }

  .honeymood-footer .footer-copyright {
    font-size: 0.875rem;
  }

  .honeymood-footer .footer-policy-list {
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .honeymood-footer .footer-policy-list a {
    font-size: 0.875rem;
    color: inherit;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .honeymood-footer .footer-policy-list a:hover {
    opacity: 1;
    text-decoration: underline;
  }

  /* Mobile Centering Styles */
  @media screen and (max-width: 749px) {
    .honeymood-footer .footer-container .footer-content {
      grid-template-columns: 1fr;
      text-align: center;
      justify-items: center;
    }

    .honeymood-footer .menu__heading {
      justify-content: center;
    }

    .honeymood-footer .footer-brand {
      align-items: center;
    }

    .honeymood-footer .social-icons__wrapper {
      justify-content: center;
    }

    .honeymood-footer .footer-policy {
      flex-direction: column-reverse;
      text-align: center;
      justify-content: center;
      align-items: center;
    }

    .honeymood-footer .footer-policy-list {
      justify-content: center;
    }
  }

  .color-custom-{{ section_id }} {
    color: {{ text_color }};
    background-color: {{ background_color }};
  }
{% endstyle %}

{% schema %}
{
  "name": "t:honeymood.footer",
  "class": "section-wrapper",
  "max_blocks": 3,
  "blocks": [
    {
      "type": "menu"
    }
  ],
  "enabled_on": {
    "templates": ["*"],
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Brand Logo"
    },
    {
      "type": "color",
      "id": "section_background_color",
      "label": "t:honeymood.section_background_color",
      "default": "#FAF6ED"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "t:settings.logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 50,
      "max": 250,
      "step": 5,
      "unit": "px",
      "label": "t:settings.logo_width",
      "default": 120
    },
    {
      "type": "header",
      "content": "Footer Bottom"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "t:honeymood.footer_copyright_label",
      "default": "t:honeymood.footer_copyright"
    },
    {
      "type": "checkbox",
      "id": "show_policy_links",
      "label": "Show store policies",
      "default": true
    },
    {
      "type": "header",
      "content": "Social Media Icons"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "t:settings.color"
    },
    {
      "type": "url",
      "id": "facebook_url",
      "label": "Facebook"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram"
    },
    {
      "type": "url",
      "id": "youtube_url",
      "label": "YouTube"
    },
    {
      "type": "url",
      "id": "tiktok_url",
      "label": "TikTok"
    },
    {
      "type": "url",
      "id": "twitter_url",
      "label": "Twitter / X"
    },
    {
      "type": "url",
      "id": "threads_url",
      "label": "Threads"
    },
    {
      "type": "url",
      "id": "linkedin_url",
      "label": "LinkedIn"
    },
    {
      "type": "url",
      "id": "bluesky_url",
      "label": "Bluesky"
    },
    {
      "type": "url",
      "id": "custom_url",
      "label": "Custom Link"
    },
    {
      "type": "header",
      "content": "Section Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "default": "#2D341B"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:settings.text_color",
      "default": "#F1EDE3"
    }
  ],
  "presets": [
    {
      "name": "t:honeymood.footer",
      "category": "t:categories.footer",
      "settings": {
        "background_color": "#2D341B",
        "text_color": "#F1EDE3",
        "logo_width": 120,
        "show_policy_links": true,
        "instagram_url": "https://www.instagram.com/honeymood/",
        "facebook_url": "https://www.facebook.com/honeymood",
        "tiktok_url": "https://www.tiktok.com/@honeymood",
        "twitter_url": "https://twitter.com/honeymood"
      },
      "blocks": {
        "menu-1": {
          "type": "menu",
          "settings": {
            "menu": "main-menu",
            "heading": "Explore",
            "text_color": "#F1EDE3"
          }
        },
        "menu-2": {
          "type": "menu",
          "settings": {
            "menu": "customer-service",
            "heading": "Customer Service",
            "text_color": "#F1EDE3"
          }
        },
        "menu-3": {
          "type": "menu",
          "settings": {
            "menu": "my-account",
            "heading": "My Account",
            "text_color": "#F1EDE3"
          }
        }
      },
      "block_order": ["menu-1", "menu-2", "menu-3"]
    }
  ]
}
{% endschema %}
